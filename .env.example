# Copy the parts you need to the files named below. Never commit them.

# .env.test.local, for the database access tests (npm run test:db).
# Use a development project: the tests create and remove their own accounts.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# .env.local, to apply migrations from this machine:
#   npx supabase db push --db-url "$SUPABASE_DB_URL"
# Supabase dashboard > Connect > Session pooler.
SUPABASE_DB_URL=
